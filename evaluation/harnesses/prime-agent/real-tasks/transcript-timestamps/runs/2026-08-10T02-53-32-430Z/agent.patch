+// Timestamps belong to the conversation, not the machinery: user prompts and
+// the first assistant prose reply to each prompt get one (rendered first in the
+// header); tool calls, question cards, system notices, and assistant
+// continuations of the same reply do not. "First reply" walks back past
+// non-conversational rows (tool/system) so a reply that opens with tool calls
+// still counts.
+export function isFirstAssistantReply(messages: Msg[], index: number): boolean {
+  if (messages[index]?.role !== "assistant") return false;
+  for (let i = index - 1; i >= 0; i--) {
+    const role = messages[i].role;
+    if (role === "assistant") return false;
+    if (role === "user") return true;
+    // tool/system/queued rows are not conversational — keep looking.
+  }
+  return true;
+}
