+// Timestamp placement is for conversational rows only: a user prompt leads
+// with its timestamp, and so does the agent's first prose reply to that
+// prompt — even when tool calls streamed in between (tool/system rows are
+// skipped, not treated as a boundary). Later assistant messages in the same
+// run are continuations: collapsed header, no timestamp.
+export function isFirstAssistantReply(messages: Msg[], index: number): boolean {
+  if (messages[index]?.role !== "assistant") return false;
+  for (let i = index - 1; i >= 0; i--) {
+    const role = messages[i].role;
+    if (role === "assistant") return false;
+    if (role === "user") return true;
+  }
+  return true;
+}
